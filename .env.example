# Secret signing access tokens. At least 32 bytes. Rotate by re-issuing.
AUTH_JWT_SECRET=replace-me-with-32-bytes-minimum-of-random

# Secret keying the stored one-time-code hashes. Separate from the JWT secret:
# different rotation schedule, different blast radius.
AUTH_OTP_SECRET=replace-me-with-another-32-bytes-of-random

# Postgres connection used by the reference adapter.
DATABASE_URL=postgres://user:password@localhost:5432/app

# Delivery for one-time codes. This library does not talk to a gateway; wire
# your own provider behind the `deliverCode` hook in examples/server.ts.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=
